cabal-version: 3.0
name: en-server
version: 0.1.0.0
synopsis: Standalone en authorization service
description:
  A thin application layer wiring en-core's engine over en-postgres' store and
  serving en-servant's API. The deployable standalone form of the toolkit
  (the library form is en-core embedded directly).

license: MIT
author: Nadeem Bitar
maintainer: nadeem@gmail.com
category: Security, Authorization

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints
    -Werror=missing-fields

common shared
  default-language: GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    OverloadedLabels
    OverloadedStrings

executable en-server
  import: warnings, shared
  hs-source-dirs: app
  main-is: Main.hs
  other-modules:
    Config
    Maintenance
    Metrics
    Middleware
    Observability
    Telemetry
    Tenant

  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-depends:
    aeson,
    async,
    base >=4.19 && <5,
    biscuit-haskell,
    bytestring,
    containers,
    effectful,
    effectful-core,
    en-biscuit,
    en-core,
    en-postgres,
    en-servant,
    generic-lens >=2.2 && <2.4,
    hasql,
    hasql-pool ^>=1.4,
    hs-opentelemetry-api >=1.0 && <1.1,
    hs-opentelemetry-exporter-otlp >=1.0 && <1.1,
    hs-opentelemetry-instrumentation-servant >=1.0 && <1.1,
    hs-opentelemetry-instrumentation-wai >=1.0 && <1.1,
    hs-opentelemetry-sdk >=1.0 && <1.1,
    http-types,
    ram,
    relay-pagination-servant >=0.1 && <0.2,
    servant,
    servant-health ^>=0.1,
    text,
    time,
    unix,
    uuid,
    wai,
    warp,
    warp-tls,

-- Drives a real en-server process over HTTP against ephemeral PostgreSQL and reports
-- throughput and latency, compares two binaries (`ab`), and previews in-process
-- interference. Not part of the CI gate: shared runners are too noisy for a
-- process-level A/B. See
-- docs/plans/72-build-an-en-server-load-benchmark-and-record-the-single-tenant-baseline.md.
executable en-server-loadbench
  import: warnings, shared
  hs-source-dirs:
    loadbench
    test-support

  main-is: Main.hs
  other-modules:
    Fixture
    ServerHarness
    Verdict
    Workload

  -- -A64m keeps the load generator's own minor collections rare, so its pauses do not
  -- land inside measured latencies.
  ghc-options:
    -threaded
    -rtsopts
    "-with-rtsopts=-N -A64m"

  build-depends:
    aeson,
    async,
    base,
    bytestring,
    containers,
    directory,
    en-migrations,
    ephemeral-pg >=0.3.1 && <0.4,
    filepath,
    hasql,
    http-client >=0.7 && <0.8,
    http-types,
    network >=3.1 && <3.3,
    pg-migrate ^>=1.2.0.0,
    process,
    temporary,
    text,
    unix,
    vector >=0.13 && <0.14,
    vector-algorithms >=0.9 && <0.10,

test-suite en-server-middleware-test
  import: warnings, shared
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    app

  main-is: MiddlewareSpec.hs
  other-modules: Middleware
  build-depends:
    base,
    bytestring,
    containers,
    en-core,
    en-servant,
    generic-lens,
    http-types,
    ram,
    servant-health,
    tasty,
    tasty-hunit,
    text,
    wai,

-- The configuration rules, through the pure parser in app/Config.hs.
test-suite en-server-config-tests
  import: warnings, shared
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    app

  main-is: ConfigSpec.hs
  other-modules:
    Config
    Maintenance
    Middleware
    Telemetry

  build-depends:
    base,
    biscuit-haskell,
    bytestring,
    containers,
    effectful-core,
    en-biscuit,
    en-core,
    en-postgres,
    en-servant,
    generic-lens,
    hasql,
    hs-opentelemetry-api >=1.0 && <1.1,
    hs-opentelemetry-instrumentation-wai >=1.0 && <1.1,
    hs-opentelemetry-sdk >=1.0 && <1.1,
    http-types,
    ram,
    servant-health,
    tasty,
    tasty-hunit,
    text,
    wai,

-- Black-box tenancy proofs: starts the built en-server (and, for the upgrade case, the
-- baseline binary named by EN_BASELINE_BIN) against ephemeral PostgreSQL. See
-- docs/plans/73-serve-tenants-selected-by-api-key-each-from-its-own-isolated-stack.md.
test-suite en-server-tenant-tests
  import: warnings, shared
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    test-support

  main-is: TenantSpec.hs
  other-modules: ServerHarness
  -- How many cases run at once is set in TenantSpec's main (TASTY_NUM_THREADS).
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-tool-depends: en-server:en-server
  build-depends:
    aeson,
    base,
    bytestring,
    containers,
    directory,
    en-migrations,
    ephemeral-pg >=0.3.1 && <0.4,
    filepath,
    hasql,
    http-client >=0.7 && <0.8,
    http-types,
    network >=3.1 && <3.3,
    pg-migrate ^>=1.2.0.0,
    process,
    tasty,
    tasty-hunit,
    temporary,
    text,
    unix,
