with-compiler: ghc-9.12.4

packages:
    en-core
    en-migrations
    en-postgres
    en-servant
    en-server
    en-client
    en-example
    en-biscuit

-- ============================================================
-- DEPENDENCY VERSION PINS — use Hackage packages, not local checkouts.
-- ============================================================

constraints:
    ephemeral-pg ==0.2.1.0,
    tasty-bench ==0.5

-- ------------------------------------------------------------
-- biscuit-haskell for en-biscuit (optional Biscuit token layer).
--
-- The Hackage release of biscuit-haskell-0.4.0.0 caps
-- template-haskell < 2.22, which excludes the template-haskell 2.23 that
-- ships with GHC 9.12.4 (this project's compiler). The Mori-registered source
-- (eclipse-biscuit/biscuit-haskell) has the same 0.4.0.0 version but widened
-- bounds (template-haskell < 2.24, megaparsec < 9.8) that build under GHC 9.12.
-- Until a fixed release is on Hackage, pin the GHC-9.12-compatible source here.
-- biscuit-servant and biscuit-wai are deliberately not pulled in yet; add their
-- subdirs when a later plan needs Servant/WAI integration.
-- ------------------------------------------------------------
source-repository-package
    type:     git
    location: https://github.com/shinzui/biscuit-haskell-project.git
    tag:      aef4272f0d44eec75c79aa6c2dd00c4200401829
    subdir:   biscuit-haskell/biscuit

-- ------------------------------------------------------------
-- openapi-hs / servant-openapi-hs for en-servant's OpenAPI document.
--
-- Hackage openapi3/servant-openapi3 do not build against this project's GHC
-- 9.12.4 / servant 0.20.3 without patches. These forks target exactly that
-- toolchain (their cabal files require base >=4.21) and emit OpenAPI 3.1.
-- servant-openapi-hs additionally carries a HasOpenApi port for servant's
-- MultiVerb, which is what lets en's per-operation error responses (400/422/503)
-- appear in the generated document. Neither is on Hackage; pin the sources.
-- ------------------------------------------------------------
source-repository-package
    type:     git
    location: https://github.com/shinzui/openapi-hs.git
    tag:      965340a30fad0782f2c964ab97b4ab0f12fa044d

source-repository-package
    type:     git
    location: https://github.com/shinzui/servant-openapi-hs.git
    tag:      7cbbc234cb7c0e900495b2f676e2912a7f456ff0
