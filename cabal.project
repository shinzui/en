with-compiler: ghc-9.12.4
packages:
  en-core
  en-migrations
  en-postgres
  en-servant
  en-server
  en-client
  en-example
  en-biscuit

-- ============================================================
-- DEPENDENCY VERSION PINS — use Hackage packages, not local checkouts.
-- ============================================================
constraints:
  -- pg-migrate computes migration checksums with crypton >= 1.1 && < 1.2.
  -- This is load-bearing again now that the biscuit pin is upstream main: the
  -- Hackage biscuit-haskell-0.5.0.0 (revision 1) carries the same version
  -- number but caps crypton < 1.1 with memory, and this constraint is what keeps
  -- the solver off that combination. See
  -- docs/adr/0002-crypton-1-1-binds-en-s-dependency-closure-through-a-biscuit-haskell-fork.md.
  crypton >= 1.1,
  ephemeral-pg ==0.3.1.0,
  tasty-bench ==0.5

-- ------------------------------------------------------------
-- biscuit-haskell for en-biscuit (optional Biscuit token layer).
--
-- en needs both GHC 9.12 support (template-haskell 2.23) and crypton 1.1,
-- which replaced the deprecated `memory` with its maintained fork `ram` (so
-- `ByteArrayAccess Ed25519.PublicKey` now comes from `ram`). pg-migrate
-- (mori://shinzui/pg-migrate) requires crypton >= 1.1.
--
-- Hackage has only half of that. biscuit-haskell-0.5.0.0 fixes the GHC 9.12
-- bound, but its revision 1 (2026-10-02) pins crypton >= 1.0 && < 1.1 together
-- with memory. Upstream main (mori://eclipse-biscuit/biscuit-haskell) merged
-- the ram switch the same day (PR #115: crypton >= 1.1 && < 2, ram) and has
-- not released it.
--
-- So we pin upstream main by commit. This replaces the former fork
-- mori://shinzui/biscuit-haskell, whose only patch PR #115 now carries; the
-- library source is identical. Drop the pin for Hackage once a release after
-- 0.5.0.0 depends on crypton >= 1.1 and ram.
--
-- biscuit-servant and biscuit-wai are deliberately not pulled in yet; add their
-- subdirs when a later plan needs Servant/WAI integration.
-- ------------------------------------------------------------
source-repository-package
  type: git
  location: https://github.com/eclipse-biscuit/biscuit-haskell.git
  tag: 469eaedc66be6e7629954bfd631b1842a968a33a
  subdir: biscuit

-- ------------------------------------------------------------
-- Servant route naming for OpenTelemetry.
--
-- Upstream (mori://cachix/hs-opentelemetry-instrumentation-servant) now
-- admits the hs-opentelemetry 1.0 cohort on main (c830d53, version 1.0.0.0),
-- but it is not on Hackage and its HasEndpoint instances still do not cover
-- MultiVerb or AuthProtect, so en's NamedRoutes API fails to type-check at the
-- middleware call site. mori://shinzui/hs-opentelemetry-instrumentation-servant
-- branch feat/multiverb-authprotect is upstream main plus exactly one commit
-- adding those two instances. Drop this pin once upstream merges the instances
-- and releases to Hackage.
-- ------------------------------------------------------------
source-repository-package
  type: git
  location: https://github.com/shinzui/hs-opentelemetry-instrumentation-servant.git
  tag: d79a26337faedc37fd9301e58a207cb5834fc909
