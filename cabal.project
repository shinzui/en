with-compiler: ghc-9.12.4

packages:
    en-core
    en-migrations
    en-postgres
    en-servant
    en-server
    en-client
    en-example
    en-biscuit

-- ============================================================
-- DEPENDENCY VERSION PINS — use Hackage packages, not local checkouts.
-- ============================================================

constraints:
    -- pg-migrate computes migration checksums with crypton >= 1.1 && < 1.2.
    -- The biscuit-haskell fork below now requires crypton ^>= 1.1 in its own
    -- right, so this is belt-and-braces: it keeps the solver off 1.0.6 even if
    -- the biscuit pin is dropped. See
    -- docs/plans/62-replace-codd-with-pg-migrate-as-en-s-migration-system.md.
    crypton >= 1.1,
    ephemeral-pg ==0.2.1.0,
    tasty-bench ==0.5

-- ------------------------------------------------------------
-- biscuit-haskell for en-biscuit (optional Biscuit token layer).
--
-- Two things keep this off Hackage. The published biscuit-haskell-0.4.0.0 is
-- still at revision 0 (2024-07-31): it caps template-haskell < 2.22, which
-- excludes the 2.23 shipping with GHC 9.12.4, and it predates the cryptonite
-- -> crypton rename entirely. Upstream main has since fixed the GHC 9.12 half
-- (template-haskell < 2.24, megaparsec < 9.8, crypton) but has never released
-- it; the open "Release 0.5.0.0" PR does not change that.
--
-- The remaining half is ours. crypton 1.1 replaced the deprecated `memory`
-- package with its maintained fork `ram`, so `ByteArrayAccess Ed25519.PublicKey`
-- now comes from `ram`. Upstream still says `crypton ^>= 1.0` + `memory`, which
-- cannot co-exist with pg-migrate (mori://shinzui/pg-migrate) requiring
-- crypton >= 1.1. Relaxing the bound alone is not enough -- the solver succeeds
-- and the compile fails on the missing instance -- so the bound and the
-- byte-array dependency have to move together.
--
-- So we pin our fork, mori://shinzui/biscuit-haskell: a real GitHub fork of
-- eclipse-biscuit/biscuit-haskell whose fix/crypton-1.1-ram branch is upstream
-- main plus exactly one cabal commit. The patch used to live vendored inside the
-- corpus mirror (mori://eclipse-biscuit/biscuit-haskell), which made it
-- unofferable upstream; that mirror is pure upstream again.
--
-- biscuit-servant and biscuit-wai are deliberately not pulled in yet; add their
-- subdirs when a later plan needs Servant/WAI integration.
-- ------------------------------------------------------------
source-repository-package
    type:     git
    location: https://github.com/shinzui/biscuit-haskell.git
    tag:      8c0b3c5a13ce4a310737c0336f2ae167a1597588
    subdir:   biscuit

-- ------------------------------------------------------------
-- Servant route naming for OpenTelemetry.
--
-- Upstream has no released 0.3.0.0 package. Its HasEndpoint instances do not
-- cover MultiVerb or AuthProtect, so en's NamedRoutes API fails to type-check
-- at the middleware call site, and its hs-opentelemetry-api ==0.3.* bound
-- excludes the 1.0 cohort. mori://shinzui/hs-opentelemetry-instrumentation-servant
-- supplies those instances, admits the 1.0 API, and keeps the example's
-- shutdown call compatible with that API. Keep this commit pin load-bearing
-- and deliberate until upstream releases the route and API changes.
-- ------------------------------------------------------------
source-repository-package
    type:     git
    location: https://github.com/shinzui/hs-opentelemetry-instrumentation-servant.git
    tag:      7a6f692e85295f965cd1827f9354c28af9e62742
