cabal-version: 3.0
name:          en-postgres
version:       0.1.0.0
synopsis:
  PostgreSQL implementations of en's store effects + revisions

description:
  PostgreSQL (hasql) implementations of en-core's TupleStore effect and the
  pg_snapshot-based revision / consistency-token machinery: MVCC point-in-time
  reads via pg_visible_in_snapshot, the revision partial order, and the
  quantized "optimized revision".

license:       MIT
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
category:      Security, Authorization, Database

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

common shared
  default-language:   GHC2024
  default-extensions:
    DerivingStrategies
    OverloadedRecordDot
    OverloadedStrings

library
  import:          warnings, shared
  hs-source-dirs:  src
  exposed-modules:
    En.Postgres.Database
    En.Postgres.Datastore
    En.Postgres.Revision
    En.Postgres.TupleStore
    En.Postgres.Watch

  build-depends:
    , aeson
    , base            >=4.19 && <5
    , bytestring
    , containers
    , effectful
    , effectful-core
    , en-core
    , en-migrations
    , hasql
    , hasql-pool      ^>=1.4
    , scientific
    , text
    , time

test-suite en-postgres-revision-tests
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , base
    , effectful
    , effectful-core
    , en-core
    , en-postgres
    , text
    , time

test-suite en-postgres-integration-tests
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: integration-test
  main-is:        Main.hs

  -- The write-race scenario runs two guarded revokes on two connections at once.
  -- Without -threaded, the first thread's blocking libpq call parks the whole
  -- runtime and the second never reaches the lock it is supposed to contend for.
  ghc-options:    -threaded
  build-depends:
    , base
    , containers
    , effectful
    , effectful-core
    , en-core
    , en-postgres
    , ephemeral-pg
    , hasql
    , text
    , time

executable en-lookup-spike
  import:         warnings, shared
  hs-source-dirs: lookup-spike
  main-is:        Main.hs
  build-depends:
    , base
    , ephemeral-pg
    , hasql
    , text

benchmark en-postgres-bench
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  ghc-options:    -fproc-alignment=64
  build-depends:
    , base
    , en-core
    , en-postgres
    , tasty-bench
