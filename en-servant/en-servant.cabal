cabal-version: 3.0
name:          en-servant
version:       0.1.0.0
synopsis:      Servant API and a fail-closed authorization helper for en
description:
  The en HTTP API (check / lookup / expand / write) as a Servant API type, plus
  requirePermission: a fail-closed Handler helper that gates host-route logic on
  en.check, returning () when the decision is Allowed and throwing a 403 otherwise.
  It is invoked by call discipline inside a handler, not enforced by the route's
  type; a handler that never calls it is never gated.

license:       MIT
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
category:      Security, Authorization, Web

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints
    -Werror=missing-fields

common shared
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DuplicateRecordFields
    NoFieldSelectors
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings
    TypeFamilies

library
  import:          warnings, shared
  hs-source-dirs:  src
  exposed-modules:
    En.Check.Api
    En.Expand.Api
    En.Lookup.Api
    En.Schema.Api
    En.Servant.API
    En.Servant.Authorize
    En.Servant.OpenApi
    En.Servant.Response
    En.Servant.Seam
    En.Servant.Wire
    En.Tuple.Api

  build-depends:
    , aeson
    , base                >=4.19 && <5
    , biscuit-haskell
    , bytestring
    , containers
    , effectful
    , effectful-core
    , en-biscuit
    , en-core
    , en-postgres
    , lens
    , openapi-hs
    , servant
    , servant-openapi-hs
    , servant-server
    , sop-core
    , text
    , time
    , transformers

-- Writes docs/api/openapi.json. An executable rather than a test so the artifact is a
-- deterministic build product, and a `just openapi` git-diff check catches drift.
executable en-openapi
  import:         warnings, shared
  main-is:        OpenApi.hs
  hs-source-dirs: app
  build-depends:
    , aeson-pretty
    , base
    , bytestring
    , directory
    , en-servant

test-suite en-servant-tests
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , aeson
    , base
    , biscuit-haskell
    , bytestring
    , containers
    , effectful
    , effectful-core
    , en-biscuit
    , en-core
    , en-postgres
    , en-servant
    , http-types
    , openapi-hs
    , servant
    , servant-server
    , text
    , time
    , wai
    , wai-extra
