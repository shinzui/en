cabal-version: 3.0
name:          en-core
version:       0.1.0.0
synopsis:
  Schema-parametric ReBAC engine: model, reachability, check/lookup, revisions

description:
  en-core is the transport- and database-agnostic heart of en. It defines the
  authorization model (relation tuples, userset-rewrite rules, caveats), the
  Schema -> reachability-graph compiler, the check / lookup / expand algorithms
  expressed over a TupleStore effect interface, and the revision / consistency-token
  types. It depends on no Servant, WAI, PostgreSQL, or HTTP library; concrete
  implementations live in en-postgres, en-servant, and en-server.

license:       MIT
author:        Nadeem Bitar
maintainer:    nadeem@gmail.com
category:      Security, Authorization

common warnings
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

common shared
  default-language:   GHC2024
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DerivingStrategies
    DuplicateRecordFields
    LambdaCase
    OverloadedLabels
    OverloadedRecordDot
    OverloadedStrings

library
  import:          warnings, shared
  hs-source-dirs:  src
  exposed-modules:
    En.Caveat
    En.Caveat.Value
    En.Check
    En.Conformance.Kikan
    En.Decision
    En.Effect.ConsistencyStore
    En.Effect.TupleStore
    En.Error
    En.Expand
    En.Lookup
    En.Prelude
    En.Reachability
    En.Revision
    En.Schema
    En.Schema.Builder
    En.Tuple

  build-depends:
    , base                  >=4.19 && <5
    , bytestring
    , containers
    , effectful
    , effectful-core
    , text
    , time
    , unordered-containers

test-suite en-core-interface-tests
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Main.hs
  build-depends:
    , base
    , containers
    , effectful
    , effectful-core
    , en-core
    , text
    , time

test-suite en-core-conformance
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: conformance
  main-is:        Main.hs
  build-depends:
    , base
    , effectful
    , effectful-core
    , en-core

benchmark en-core-bench
  import:         warnings, shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  ghc-options:    -fproc-alignment=64
  build-depends:
    , base
    , containers
    , effectful
    , effectful-core
    , en-core
    , tasty-bench
    , text
    , time
